output "DP-1" {
    mode "1920x1080@165.001"
    scale 1.0

    transform "normal"

    position x=0 y=0
}

output "eDP-1" {
    mode "1920x1200@60.001"
    scale 1.23

    transform "normal"

    position x=0 y=0
}

prefer-no-csd
gestures {
    hot-corners {
        off
    }
}

input {
    focus-follows-mouse max-scroll-amount="10%"
    disable-power-key-handling
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        accel-profile "flat"
        scroll-method "on-button-down"
        scroll-button 274
        // scroll-button-lock
    }
    trackpoint {
    }
}



layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}
overview {
    workspace-shadow {
        off
    }
}


spawn-at-startup "vesktop"
spawn-at-startup "pear-desktop"
// spawn-at-startup "spotify"


screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"





window-rule {
    match is-active=false
    opacity 0.97
}
debug {
    honor-xdg-activation-with-invalid-serial
}


include "binds.kdl"
include "global.kdl"
include "layouts.kdl"
include "applayouts.kdl"

// include "noctalia.kdl"

// DMS Include Configs
include "dms/alttab.kdl"
include "dms/colors.kdl"
include "dms/layout.kdl"


