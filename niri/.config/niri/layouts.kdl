layout {
    gaps 8
    struts{
        top 1
        bottom 1
    }
    focus-ring{
        width 3
    }
    border{
        width 3
    }
}

window-rule {
 
}

/* Noctalia: blur everywhere without xray for a better look */
layer-rule {
  match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
  background-effect {
    xray false
  }
}
window-rule{
    background-effect {
        blur true
        xray true
    }
    clip-to-geometry true
    geometry-corner-radius 15
}
window-rule {
    match app-id="python3"
    open-floating false
}