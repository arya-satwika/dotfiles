layout {
    gaps 8
    struts{
        top 1
        bottom 1
        left 1
        right 1
    }
    focus-ring{
        width 2
    }
    border{
        width 2
    }
}


layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    // blur false
  }
}

window-rule{
    background-effect {
        blur true
        xray true
    }
    clip-to-geometry true
    geometry-corner-radius 15
}
window-rule {
    match app-id="python3"
    open-floating false
}