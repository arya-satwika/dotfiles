binds {

    // APP SHORTCUTS
    Mod+T { spawn-sh "kitty -e btop"; }
    Mod+Shift+I { spawn-sh "kitty -e pacsea"; }
    Mod+N { spawn "code"; }
    Mod+E { spawn "dolphin"; }
    Mod+B { spawn "helium-browser"; }
    Mod+Return { spawn-sh "kitty"; }
    Mod+M { spawn "pear-desktop"; }
    // Toggle Droidcam
    Mod+F12 { spawn-sh "pkill droidcam-cli || exec droidcam-cli 192.168.0.196 4747";}


    // NOTE: No direct cycleoutput in Noctalia; mapped to muteOutput as closest alternative
    Ctrl+F3 { spawn-sh "dms ipc call audio cycleoutput"; }



    // === Application Launchers ===
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn-sh "dms ipc call spotlight toggle";
    }
    // === Open Power Menu ===
    Mod+Shift+P { spawn-sh "dms ipc call powermenu toggle"; }
    Alt+Grave { spawn-sh "dms ipc call mic mute"; }

    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn-sh "dms ipc call clipboard toggle";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn-sh "dms ipc call settings toggle";
    }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn-sh "dms ipc wallpaperCarousel toggle";
    }
    Mod+Q hotkey-overlay-title="Screen toolkit" {
        spawn-sh "qs -c noctalia-shell ipc call plugin:screen-toolkit toggle";
    }
    Mod+P hotkey-overlay-title="pomodoro" {
        spawn-sh "dms ipc widget toggle dankPomodoroTimer";
    }
    // === Security ===
    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn-sh "dms ipc call lock lock";
    }

     // === Audio & Brightness ===
    XF86AudioRaiseVolume { spawn-sh "dms ipc call audio increment 5"; }
    XF86AudioLowerVolume { spawn-sh "dms ipc call audio decrement 5"; }
    XF86AudioMute { spawn-sh "dms ipc call audio mute"; }
    XF86MonBrightnessUp { spawn-sh "dms ipc call brightness increment 10"; }
    XF86MonBrightnessDown { spawn-sh "dms ipc call brightness decrement 10"; }



    // === System & Overview ===
    Mod+Tab repeat=false { toggle-overview; }
    // === Window Management ===
    Mod+W repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // === Focus Navigation ===
    Mod+BracketLeft { focus-column-left; }
    Mod+BracketRight { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }


    // === Window Movement ===
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+BracketLeft { move-column-left; }
    Mod+Shift+BracketRight { move-column-right; }
    Mod+Shift+Apostrophe   { move-column-to-workspace-up; }
    Mod+Shift+Slash        { move-column-to-workspace-down; }

    // === Column Navigation ===
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // === Monitor Navigation ===
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    // === Move to Monitor ===
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // === Workspace Navigation ===
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    // Mod+U              { focus-workspace-down; }
    // Mod+I              { focus-workspace-up; }
    Mod+Apostrophe     { focus-workspace-up; }
    Mod+Slash          { focus-workspace-down; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // === Move Workspaces ===
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    // Mod+Shift+U         { move-workspace-down; }
    // Mod+Shift+I         { move-workspace-up; }

    // === Mouse Wheel Navigation ===
    Mod+WheelScrollDown cooldown-ms=60   { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=60   { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft  cooldown-ms=150 { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown  { focus-column-right; }
    Mod+Shift+WheelScrollUp    { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // === Numbered Workspaces ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // === Move to Numbered Workspaces ===
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // === Column Management ===
    Mod+Alt+BracketLeft  { consume-or-expel-window-left; }
    Mod+Alt+BracketRight { consume-or-expel-window-right; }

    // === Sizing & Layout ===
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // === Manual Sizing ===
    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // === Screenshots ===
    XF86Launch1 { screenshot; }
    Ctrl+XF86Launch1 { screenshot-screen; }
    Alt+XF86Launch1 { screenshot-window; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }


}